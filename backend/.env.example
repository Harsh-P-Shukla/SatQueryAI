# Public URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
INFERENCE_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL. Production should prefer DATABASE_URL from a managed provider.
DATABASE_URL=
PGSSLMODE=disable

# Local PostgreSQL fallback for development when DATABASE_URL is not set.
PGHOST=localhost
PGPORT=5432
PGDATABASE=isro_gi
PGUSER=
PGPASSWORD=
PG_CONNECTION_TIMEOUT_MS=5000

# Storage. Keep local for development. Use http in production with a persistent
# object-storage proxy that supports PUT/DELETE at /uploads/:filename and
# /results/:filename, and public GET URLs from STORAGE_PUBLIC_URL_BASE.
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=
STORAGE_PUBLIC_URL_BASE=
STORAGE_UPLOAD_URL=
STORAGE_DELETE_URL=
STORAGE_AUTH_TOKEN=

# Public RGB baseline. Use original with the original 7B model and real adapters.
SATQUERY_MODEL_MODE=public
SATQUERY_BASE_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
SATQUERY_MAX_PIXELS=401408
# Keep YOLO on CPU to leave GPU memory for Qwen; detection is slower.
SATQUERY_YOLO_DEVICE=cpu
