PGHOST=localhost
PGPORT=5432
PGDATABASE=isro_gi
# Set these to your actual PostgreSQL credentials in backend/.env.
PGUSER=
PGPASSWORD=

# Public RGB baseline. Use original with the original 7B model and real adapters.
SATQUERY_MODEL_MODE=public
SATQUERY_BASE_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
SATQUERY_MAX_PIXELS=401408
# Keep YOLO on CPU to leave GPU memory for Qwen; detection is slower.
SATQUERY_YOLO_DEVICE=cpu
